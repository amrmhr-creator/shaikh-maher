---
// قارئ PDF داخل الصفحة: نافذة تُفتح من أي زر يحمل data-pdf، ولا تُحمَّل مكتبة pdf.js إلا عند أول فتح.
// الصفحات تُرسم عند الاقتراب منها أثناء التمرير، فيبقى القارئ خفيفًا حتى مع الكتب الكبيرة.
---
<dialog class="pdf-reader" aria-label="قارئ الكتب">
  <header class="pr-bar">
    <strong class="pr-title"></strong>
    <span class="pr-page" aria-live="polite"></span>
    <div class="pr-tools">
      <button type="button" class="pr-btn" data-zoom="-1" aria-label="تصغير">−</button>
      <button type="button" class="pr-btn" data-zoom="1" aria-label="تكبير">+</button>
      <a class="pr-btn pr-download" download aria-label="تحميل">⤓</a>
      <button type="button" class="pr-btn pr-close" aria-label="إغلاق">✕</button>
    </div>
  </header>
  <div class="pr-pages" tabindex="0"></div>
  <div class="pr-status" hidden>
    <p class="pr-msg"></p>
    <a class="btn gold pr-open" target="_blank" rel="noopener" hidden>افتح الملف في نافذة جديدة</a>
  </div>
</dialog>

<style>
  .pdf-reader {
    width: min(100vw, 980px);
    height: 100dvh;
    max-width: 100vw;
    max-height: 100dvh;
    margin: 0 auto;
    padding: 0;
    border: 0;
    background: #2b2a27;
    color: #f5f1e6;
    display: none;
    flex-direction: column;
  }
  .pdf-reader[open] { display: flex; }
  .pdf-reader::backdrop { background: rgb(0 0 0 / 70%); }
  .pr-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: var(--deep-2);
    border-bottom: 1px solid rgb(216 180 106 / 30%);
  }
  .pr-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--font-display); font-size: 1.1rem; }
  .pr-page { font-size: .9rem; color: var(--on-deep-muted); white-space: nowrap; }
  .pr-tools { display: flex; gap: 6px; }
  .pr-btn {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    border: 1px solid rgb(255 255 255 / 20%);
    background: rgb(255 255 255 / 6%);
    color: inherit;
    font: inherit;
    font-size: 1.15rem;
    text-decoration: none;
    cursor: pointer;
  }
  .pr-btn:hover { background: var(--gold); color: #1c1a14; }
  .pr-pages {
    flex: 1;
    overflow: auto;
    padding: 16px;
    display: grid;
    justify-content: center;
    align-content: start;
    gap: 14px;
    outline: none;
  }
  .pr-pages > div {
    width: var(--w);
    aspect-ratio: var(--r);
    background: #fff;
    box-shadow: 0 2px 14px rgb(0 0 0 / 40%);
  }
  .pr-pages canvas { display: block; width: 100%; height: 100%; }
  .pr-status { padding: 40px 20px; text-align: center; }
  .pr-msg { margin: 0 0 16px; }
</style>

<script>
  const PDFJS_ROOT = 'https://cdn.jsdelivr.net/npm/pdfjs-dist@4.10.38/';
  const PDFJS = `${PDFJS_ROOT}build/`;
  const AR = '٠١٢٣٤٥٦٧٨٩';
  const ar = (n: number) => String(n).replace(/\d/g, (d) => AR[+d]);
  let lib: any;

  const dialog = document.querySelector<HTMLDialogElement>('dialog.pdf-reader');
  if (dialog) {
    const pages = dialog.querySelector<HTMLElement>('.pr-pages')!;
    const status = dialog.querySelector<HTMLElement>('.pr-status')!;
    const msg = dialog.querySelector<HTMLElement>('.pr-msg')!;
    const openLink = dialog.querySelector<HTMLAnchorElement>('.pr-open')!;
    const pageLabel = dialog.querySelector<HTMLElement>('.pr-page')!;
    const download = dialog.querySelector<HTMLAnchorElement>('.pr-download')!;
    let doc: any;
    let zoom = 1;
    let observer: IntersectionObserver | undefined;
    let token = 0;

    const say = (text: string, offerTab = false) => { msg.textContent = text; status.hidden = !text; openLink.hidden = !offerTab; };
    // ملفات المواقع الأخرى تمر عبر الخادم حتى لا يمنعها المتصفح.
    const sameOrigin = (src: string) => new URL(src, location.href).origin === location.origin;
    const fetchUrl = (src: string) => (sameOrigin(src) ? src : `/pdf/?src=${encodeURIComponent(src)}`);

    const baseWidth = () => Math.min(pages.clientWidth - 32, 900);

    async function draw(box: HTMLElement) {
      const n = Number(box.dataset.page);
      const t = token;
      const page = await doc.getPage(n);
      if (t !== token) return;
      const width = box.clientWidth;
      const vp1 = page.getViewport({ scale: 1 });
      const scale = (width / vp1.width) * Math.min(window.devicePixelRatio || 1, 2);
      const vp = page.getViewport({ scale });
      const canvas = document.createElement('canvas');
      canvas.width = Math.floor(vp.width);
      canvas.height = Math.floor(vp.height);
      await page.render({ canvasContext: canvas.getContext('2d')!, viewport: vp }).promise;
      if (t !== token) return;
      box.replaceChildren(canvas);
      box.dataset.drawn = '1';
    }

    function layout(ratio: number) {
      token++;
      observer?.disconnect();
      pages.style.setProperty('--w', `${Math.round(baseWidth() * zoom)}px`);
      pages.style.setProperty('--r', String(ratio));
      pages.replaceChildren();
      observer = new IntersectionObserver((entries) => {
        for (const e of entries) {
          const box = e.target as HTMLElement;
          if (e.isIntersecting && !box.dataset.drawn) { box.dataset.drawn = '0'; draw(box); }
        }
        const visible = entries.filter((e) => e.isIntersecting).map((e) => Number((e.target as HTMLElement).dataset.page));
        if (visible.length) pageLabel.textContent = `صفحة ${ar(Math.min(...visible))} من ${ar(doc.numPages)}`;
      }, { root: pages, rootMargin: '600px 0px' });
      for (let i = 1; i <= doc.numPages; i++) {
        const box = document.createElement('div');
        box.dataset.page = String(i);
        pages.append(box);
        observer.observe(box);
      }
    }

    async function open(src: string, title: string) {
      dialog!.querySelector('.pr-title')!.textContent = title;
      download.href = src;
      openLink.href = src;
      pageLabel.textContent = '';
      pages.replaceChildren();
      zoom = 1;
      dialog!.showModal();
      say('جارٍ فتح الملف…');
      try {
        lib ??= await import(/* @vite-ignore */ `${PDFJS}pdf.min.mjs`);
        lib.GlobalWorkerOptions.workerSrc = `${PDFJS}pdf.worker.min.mjs`;
        doc?.destroy();
        doc = undefined;
        // يقرأ الملف على أجزاء حسب الصفحات المعروضة فقط، بطلبات Range نرسلها بأنفسنا،
        // لأن خادم الاستضافة يحذف ترويسة Accept-Ranges فلا تكتشف pdf.js دعم الأجزاء وحدها.
        const url = fetchUrl(src);
        const CHUNK = 524288;
        const part = async (begin: number, end: number) => {
          const r = await fetch(url, { headers: { Range: `bytes=${begin}-${end - 1}` } });
          if (!r.ok) throw new Error(String(r.status));
          return r;
        };
        const head = await part(0, CHUNK);
        const total = Number(head.headers.get('content-range')?.split('/')[1]);
        const first = new Uint8Array(await head.arrayBuffer());
        const common = {
          disableAutoFetch: true,
          rangeChunkSize: CHUNK,
          cMapUrl: `${PDFJS_ROOT}cmaps/`,
          cMapPacked: true,
          standardFontDataUrl: `${PDFJS_ROOT}standard_fonts/`,
        };
        let task;
        if (head.status === 206 && total > first.length) {
          const transport = new lib.PDFDataRangeTransport(total, first);
          transport.requestDataRange = (begin: number, end: number) => {
            part(begin, end)
              .then((r) => r.arrayBuffer())
              .then((buf) => transport.onDataRange(begin, new Uint8Array(buf)))
              .catch(() => {});
          };
          task = lib.getDocument({ ...common, range: transport, length: total });
        } else {
          // الخادم أعاد الملف كاملًا (ملف صغير أو بلا دعم للأجزاء)
          task = lib.getDocument({ ...common, data: first });
        }
        doc = await task.promise;
        const vp = (await doc.getPage(1)).getViewport({ scale: 1 });
        say('');
        layout(vp.width / vp.height);
      } catch {
        say('تعذر فتح الملف هنا. يمكنك فتحه في نافذة جديدة أو تحميله.', true);
      }
    }

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-pdf]');
      if (!btn) return;
      e.preventDefault();
      open(btn.dataset.pdf!, btn.dataset.pdfTitle ?? '');
    });
    dialog.querySelector('.pr-close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => { token++; observer?.disconnect(); pages.replaceChildren(); });
    for (const b of dialog.querySelectorAll<HTMLButtonElement>('[data-zoom]')) {
      b.addEventListener('click', () => {
        if (!doc) return;
        zoom = Math.max(0.6, Math.min(2.5, zoom + Number(b.dataset.zoom) * 0.25));
        const at = pages.scrollTop / (pages.scrollHeight || 1);
        layout(Number(pages.style.getPropertyValue('--r')));
        pages.scrollTop = at * pages.scrollHeight;
      });
    }
  }
</script>
