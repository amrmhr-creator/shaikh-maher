---
// بطاقة الفائدة بشكل المقاطع القصيرة (ريلز): غلاف عمودي وعليه زر تشغيل والعنوان.
import type { CollectionEntry } from '../lib/schemas';
import { u } from '../lib/site';
import Icon from './Icon.astro';
interface Props { faida: CollectionEntry<'fawaid'> }
const { faida } = Astro.props;
const d = faida.data;
const m = d.media;
const poster = m?.poster ?? (m?.type === 'image' ? m.url : undefined);
const icon = !m || m.type === 'video' ? 'play' : m.type === 'audio' ? 'headphones' : m.type === 'pdf' ? 'book' : 'image';
---
<a class="reel" href={u(`/fawaid/${faida.id}/`)}>
  <span class="reel-media">
    {poster
      ? <img src={u(poster)} alt="" loading="lazy" />
      : m?.type === 'video'
        ? <video src={`${m.url}#t=1`} preload="metadata" muted playsinline tabindex="-1" aria-hidden="true"></video>
        : <span class="reel-fallback pattern" aria-hidden="true"></span>}
  </span>
  <span class="reel-play" aria-hidden="true"><Icon name={icon} size={26} /></span>
  <span class="reel-title">{d.title}</span>
</a>
<style>
  .reel {
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    border-radius: 18px;
    overflow: hidden;
    background: var(--deep-2);
    color: var(--on-deep);
    text-decoration: none;
    box-shadow: var(--shadow);
    isolation: isolate;
  }
  .reel-media, .reel-media > * {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .reel-fallback { background-color: var(--deep); }
  .reel::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgb(0 0 0 / 75%));
  }
  .reel-play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    translate: -50% -50%;
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgb(255 255 255 / 22%);
    border: 1.5px solid rgb(255 255 255 / 70%);
    backdrop-filter: blur(6px);
    transition: transform .2s, background .2s;
  }
  .reel:hover .reel-play, .reel:focus-visible .reel-play { transform: scale(1.08); background: var(--gold); color: var(--accent-ink); }
  .reel-title {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 1;
    padding: 16px;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.5;
  }
</style>
