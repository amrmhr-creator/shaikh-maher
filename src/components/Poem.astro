---
// قصيدة عمودية: كل بيت صدر وعجز متقابلان، وينطوي البيت على الشاشات الضيقة.
// preview: عدد الأبيات الظاهرة أولًا، وباقي القصيدة خلف زر «اقرأ القصيدة كاملة».
import type { Poem } from '../data/poems';
interface Props { poem: Poem; showTitle?: boolean; eyebrow?: string; preview?: number }
const { poem, showTitle = true, eyebrow, preview } = Astro.props;
const total = poem.sections.reduce((n, s) => n + s.verses.length, 0);
const clamp = preview && preview < total ? preview : 0;
let i = 0;
---
<figure class:list={['poem', { clamped: clamp }]} style={clamp ? `--shown:${clamp}` : undefined}>
  <div class="poem-head">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    {showTitle && <h2 class="poem-title">{poem.title}</h2>}
  </div>
  {poem.sections.map((s) => (
    <div class="poem-section">
      {s.heading && <p class="poem-heading">{s.heading}</p>}
      {s.verses.map(([sadr, ajuz]) => (
        <p class:list={['verse', { extra: clamp && i++ >= clamp }]}>
          <span>{sadr}</span><i aria-hidden="true">۞</i><span>{ajuz}</span>
        </p>
      ))}
    </div>
  ))}
  {clamp > 0 && <button class="btn ghost poem-more" type="button" aria-expanded="false">اقرأ القصيدة كاملة</button>}
  <figcaption>{poem.credit}</figcaption>
</figure>
<style>
  .poem {
    margin: 0;
    padding: 40px 24px 32px;
    text-align: center;
    font-family: var(--font-display);
    background:
      linear-gradient(var(--surface), var(--surface)) padding-box,
      linear-gradient(135deg, var(--gold), var(--gold-soft), var(--gold)) border-box;
    border: 1.5px solid transparent;
    border-radius: 24px;
    box-shadow: var(--shadow);
    position: relative;
  }
  .poem::before {
    content: '';
    position: absolute;
    inset: 8px;
    border: 1px solid var(--gold-soft);
    border-radius: 18px;
    pointer-events: none;
  }
  .poem-head { margin-bottom: 20px; }
  .poem-head .eyebrow { font-family: var(--font-body); }
  .poem-title { margin: 0; }
  .poem-section + .poem-section { margin-top: 1.6em; }
  .poem-heading { color: var(--accent); font-weight: 700; margin-bottom: .6em; }
  .verse {
    display: grid;
    gap: 0 1.2em;
    margin: 0 auto .5em;
    max-width: 680px;
    font-size: 1.2rem;
    line-height: 2;
  }
  .verse i { display: none; color: var(--gold); font-style: normal; font-size: .8rem; }
  @media (min-width: 720px) {
    .verse { grid-template-columns: 1fr auto 1fr; align-items: center; }
    .verse span:first-of-type { text-align: start; }
    .verse span:last-of-type { text-align: end; }
    .verse i { display: block; }
  }
  @media (max-width: 719px) {
    .verse { padding-bottom: .5em; border-bottom: 1px dashed var(--line); }
  }
  .clamped .extra { display: none; }
  .poem-more { margin-top: 12px; font-family: var(--font-body); }
  figcaption {
    margin-top: 1.4em;
    font-family: var(--font-body);
    font-size: .9rem;
    color: var(--muted);
  }
</style>
<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.poem-more')) {
    btn.addEventListener('click', () => {
      const fig = btn.closest('.poem')!;
      const open = fig.classList.toggle('clamped') === false;
      btn.textContent = open ? 'إخفاء باقي الأبيات' : 'اقرأ القصيدة كاملة';
      btn.setAttribute('aria-expanded', String(open));
    });
  }
</script>
