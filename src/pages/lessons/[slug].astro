---
import { getCollection, renderBody } from '../../lib/content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import FaidaCard from '../../components/FaidaCard.astro';
import Icon from '../../components/Icon.astro';
import { u, lessonLabel } from '../../lib/site';
import { TOPICS } from '../../lib/topics';

const lessons = (await getCollection('lessons')).sort((a, b) => a.data.number - b.data.number);
const i = lessons.findIndex((l) => l.id === Astro.params.slug);
if (i < 0) return Astro.rewrite('/404/');
const [lesson, prev, next] = [lessons[i], lessons[i - 1], lessons[i + 1]];
const d = lesson.data;
const transcript = renderBody(lesson);
const hasTranscript = Boolean(transcript);
const fawaid = (await getCollection('fawaid')).filter(
  (f) => f.data.status === 'published' && f.data.source?.kind === 'lesson' && f.data.source.ref === lesson.id,
);
---
<Base title={d.title} description={`${lessonLabel(d.number)}: ${d.title}`}>
  <PageHero eyebrow={`${d.series} · ${lessonLabel(d.number)}`} title={d.title}>
    <ul class="tags">
      {d.topics.map((t) => <li><a class="tag" href={u(`/topics/${t}/`)}>{TOPICS[t]}</a></li>)}
    </ul>
  </PageHero>

  <div class="wrap">
    <div class="player-card card">
      <AudioPlayer src={d.audio} id={lesson.id} title={d.title} subtitle={lessonLabel(d.number)} />
    </div>

    <div class="lesson-body">
      <section class="section">
        <h2>موضوعات الدرس</h2>
        <ul class="points">{d.points.map((p) => <li>{p}</li>)}</ul>
      </section>

      {fawaid.length > 0 && (
        <section class="section">
          <h2>فوائد من هذا الدرس</h2>
          <div class="grid">{fawaid.map((f) => <FaidaCard faida={f} />)}</div>
        </section>
      )}

      <section class="section">
        <h2>التفريغ النصي</h2>
        {hasTranscript ? <div class="prose" set:html={transcript} /> : <p class="empty" data-pagefind-ignore>التفريغ النصي لهذا الدرس قيد الإعداد.</p>}
      </section>
    </div>

    <nav class="pager section" aria-label="التنقل بين الدروس" data-pagefind-ignore>
      {prev ? <a class="card link" href={u(`/lessons/${prev.id}/`)}><span class="meta">الدرس السابق</span><strong>{prev.data.title}</strong></a> : <span></span>}
      {next && <a class="card link next" href={u(`/lessons/${next.id}/`)}><span class="meta">الدرس التالي <Icon name="arrow" size={14} /></span><strong>{next.data.title}</strong></a>}
    </nav>
  </div>
</Base>
<style>
  .player-card { margin-top: -72px; position: relative; }
  .lesson-body { max-width: 780px; }
  .pager { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .pager a { display: grid; gap: 4px; text-decoration: none; color: inherit; }
  .pager strong { font-family: var(--font-display); font-size: 1.15rem; }
  .pager .next { text-align: end; }
</style>
