---
import { getCollection } from '../../lib/content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import LessonCard from '../../components/LessonCard.astro';

const lessons = (await getCollection('lessons')).sort((a, b) => a.data.number - b.data.number);
const series = [...new Set(lessons.map((l) => l.data.series))];
---
<Base title="تسجيلات المجالس" description="تسجيلات صوتية لمجالس الشيخ ماهر إسماعيل جاهين مع ملخص موضوعات كل مجلس.">
  <PageHero eyebrow="استمع" title="تسجيلات المجالس" lead="تسجيلات صوتية وشروحات إيمانية لبعض المفاهيم في علوم العقيدة والتزكية." />
  <div class="wrap">
    <p class="note"><strong>ملحوظة:</strong> لم يكن الشيخ رحمه الله يقصدُ إلى عنوانٍ بعينه يخصُّ به درسًا أو شرحًا، وإنما كان يُجيب على أسئلة الأحبة، ويسترسل بما تدعو إليه حاجةُ المستمع، وبحسب توفيق الله ومدده. وعليه، فإنَّ العناوين والتبويبات الواردة في هذه الصفحة ليست من اختيار الشيخ نفسه، كما أنَّ ما تضمَّنته من معانٍ لا يَحصُرُ ولا يستوعبُ كلَّ ما جاء في أصل الدرس المسموع، وإنما هي محاولةٌ من الفقير إلى الله، سعيًا لتيسير الأمر وتبويب المحتوى تسهيلًا على من يلتمس الفائدة. فما كان فيها من سهوٍ أو خطأ، فالعفوُ والغفرانُ مأمولان، والله من وراء القصد.</p>
    {series.map((s) => (
      <section class="section">
        <div class="section-head"><h2>{s}</h2></div>
        <div class="grid">{lessons.filter((l) => l.data.series === s).map((l) => <LessonCard lesson={l} />)}</div>
      </section>
    ))}
  </div>
</Base>
