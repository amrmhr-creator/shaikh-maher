---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import LessonCard from '../../components/LessonCard.astro';

const lessons = (await getCollection('lessons')).sort((a, b) => a.data.number - b.data.number);
const series = [...new Set(lessons.map((l) => l.data.series))];
---
<Base title="الدروس الصوتية" description="دروس الشيخ ماهر إسماعيل جاهين الصوتية مع ملخص موضوعات كل درس.">
  <PageHero eyebrow="استمع" title="الدروس الصوتية" lead="تسجيلات دروس الشيخ رحمه الله، ولكل درس صفحة فيها مشغل صوتي يتذكر موضع توقفك، وملخص لموضوعاته، والتفريغ النصي عند توفره." />
  <div class="wrap">
    <p class="note">لم يكن الشيخ يضع عناوين لدروسه، وإنما كان يجيب عن أسئلة الحاضرين. العناوين ورؤوس الموضوعات من وضع جامع المادة تيسيرًا على القارئ، وليست حصرًا لكل ما في الدرس.</p>
    {series.map((s) => (
      <section class="section">
        <div class="section-head"><h2>{s}</h2></div>
        <div class="grid">{lessons.filter((l) => l.data.series === s).map((l) => <LessonCard lesson={l} />)}</div>
      </section>
    ))}
  </div>
</Base>
