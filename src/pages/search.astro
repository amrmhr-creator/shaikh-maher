---
import Base from '../layouts/Base.astro';
import { u } from '../lib/site';
const bundle = u('/pagefind/');
---
<Base title="بحث" description="ابحث في دروس الشيخ ماهر جاهين وكتبه وفوائده.">
  <header class="page-head" data-pagefind-ignore>
    <h1>بحث في الأرشيف</h1>
    <p class="lead">ابحث في عناوين الدروس وموضوعاتها والتفريغات والكتب والفوائد.</p>
  </header>
  <div id="search" data-pagefind-ignore data-bundle={bundle}></div>
  <noscript><p class="note">البحث يحتاج إلى تفعيل جافاسكربت في المتصفح.</p></noscript>
</Base>
<script>
  const el = document.getElementById('search')!;
  const bundle = el.dataset.bundle!;
  const css = document.createElement('link');
  css.rel = 'stylesheet';
  css.href = `${bundle}pagefind-ui.css`;
  document.head.append(css);
  const s = document.createElement('script');
  s.src = `${bundle}pagefind-ui.js`;
  s.onload = () => {
    // @ts-ignore
    new window.PagefindUI({
      element: '#search',
      showSubResults: true,
      translations: { placeholder: 'اكتب كلمة للبحث…', zero_results: 'لا توجد نتائج لـ [SEARCH_TERM]', clear_search: 'مسح', load_more: 'عرض المزيد' },
    });
  };
  s.onerror = () => { el.textContent = 'فهرس البحث غير متاح في وضع التطوير، ويعمل بعد بناء الموقع.'; };
  document.body.append(s);
</script>
<style is:global>
  #search {
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--line);
    --pagefind-ui-tag: var(--surface-2);
    --pagefind-ui-font: var(--font-body);
  }
</style>
