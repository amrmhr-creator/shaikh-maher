---
import { getEntry, renderBody } from '../../lib/content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { u } from '../../lib/site';
import PdfReader from '../../components/PdfReader.astro';

const book = await getEntry('books', Astro.params.slug ?? '');
if (!book) return Astro.rewrite('/404/');
const d = book.data;
const html = renderBody(book);
---
<Base title={d.title} description={d.summary}>
  <PageHero eyebrow={d.kind === 'series' ? 'سلسلة' : 'كتاب'} title={d.title} lead={d.summary}>
    {d.pdf && (
      <div class="actions">
        <button class="btn gold" type="button" data-pdf={d.pdf} data-pdf-title={d.title}><Icon name="book" size={18} /> تصفّح الكتاب</button>
        <a class="btn on-deep" href={d.pdf} download><Icon name="download" size={18} /> تحميل PDF</a>
      </div>
    )}
  </PageHero>
  <div class="wrap split">
    <aside>
      <div class="cover">
        {d.cover && <img src={u(d.cover)} alt={`غلاف ${d.title}`} />}
        <span class="cover-fallback" aria-hidden="true"><Icon name="book" size={44} /></span>
      </div>
    </aside>
    <div>
      {html && <div class="prose" set:html={html} />}
      <h2>{d.chapterLabel}</h2>
      {d.chapters.length > 0
        ? <ol class="chapters">{d.chapters.map((c) => (
            <li>
              <span class="ch-title">{c.title}</span>
              {c.pdf && (
                <span class="ch-actions">
                  <button class="btn ghost sm" type="button" data-pdf={c.pdf} data-pdf-title={c.title}>تصفّح</button>
                  <a class="btn ghost sm" href={c.pdf} download aria-label={`تحميل ${c.title}`}><Icon name="download" size={16} /></a>
                </span>
              )}
            </li>
          ))}</ol>
        : <p class="empty">فهرس {d.chapterLabel} ونصوصها المقروءة قيد النقل إلى الموقع الجديد.</p>}
    </div>
  </div>
  <PdfReader />
</Base>
<style>
  .chapters { list-style: none; margin: 0; padding: 0; counter-reset: ch; display: grid; gap: 10px; }
  .chapters li {
    counter-increment: ch;
    display: flex; align-items: center; gap: 12px;
    padding: 12px 16px; border-radius: 12px;
    background: var(--surface); border: 1px solid var(--line);
  }
  .chapters li::before {
    content: counter(ch, arabic-indic);
    flex: none; width: 32px; height: 32px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--gold-soft); color: var(--deep); font-weight: 700;
  }
  .ch-title { flex: 1; min-width: 0; line-height: 1.7; }
  .ch-actions { display: flex; gap: 6px; flex: none; }
  .btn.sm { padding: 6px 12px; font-size: .9rem; }
  .cover {
    position: relative; aspect-ratio: 3 / 4; max-width: 280px; width: 100%;
    border-radius: 6px 12px 12px 6px; overflow: hidden;
    background: var(--deep); box-shadow: -5px 0 0 var(--gold) inset, var(--shadow-lift);
  }
  .cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }
  .cover-fallback { position: absolute; inset: 0; display: grid; place-items: center; color: var(--gold-on-deep); }
</style>
