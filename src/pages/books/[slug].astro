---
import { getEntry, renderBody } from '../../lib/content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { u } from '../../lib/site';

const book = await getEntry('books', Astro.params.slug ?? '');
if (!book) return Astro.rewrite('/404/');
const d = book.data;
const html = renderBody(book);
---
<Base title={d.title} description={d.summary}>
  <PageHero eyebrow="الكتب والرسائل" title={d.title} lead={d.summary}>
    {d.pdf && <div class="actions"><a class="btn gold" href={d.pdf} download><Icon name="download" size={18} /> تحميل الكتاب كاملًا (PDF)</a></div>}
  </PageHero>
  <div class="wrap split">
    <aside>
      <div class="cover">
        {d.cover && <img src={u(d.cover)} alt={`غلاف ${d.title}`} />}
        <span class="cover-fallback" aria-hidden="true"><Icon name="book" size={44} /></span>
      </div>
    </aside>
    <div>
      {html && <div class="prose" set:html={html} />}
      <h2>{d.chapterLabel}</h2>
      {d.chapters.length > 0
        ? <ol class="points">{d.chapters.map((c) => <li>{c.pdf ? <a href={c.pdf} target="_blank" rel="noopener">{c.title}</a> : c.title}</li>)}</ol>
        : <p class="empty" data-pagefind-ignore>فهرس {d.chapterLabel} ونصوصها المقروءة قيد النقل إلى الموقع الجديد.</p>}
    </div>
  </div>
</Base>
<style>
  .cover {
    position: relative; aspect-ratio: 3 / 4; max-width: 280px; width: 100%;
    border-radius: 6px 12px 12px 6px; overflow: hidden;
    background: var(--deep); box-shadow: -5px 0 0 var(--gold) inset, var(--shadow-lift);
  }
  .cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }
  .cover-fallback { position: absolute; inset: 0; display: grid; place-items: center; color: var(--gold-on-deep); }
</style>
