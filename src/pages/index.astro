---
import { getCollection } from '../lib/content';
import Base from '../layouts/Base.astro';
import LessonCard from '../components/LessonCard.astro';
import Icon from '../components/Icon.astro';
import Ornament from '../components/Ornament.astro';
import Poem from '../components/Poem.astro';
import { HOME_POEM } from '../data/poems';
import { u, ar, SITE_TAGLINE } from '../lib/site';
import { TOPICS, type TopicSlug } from '../lib/topics';

const lessons = (await getCollection('lessons')).sort((a, b) => a.data.number - b.data.number);
const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order);
const fawaid = (await getCollection('fawaid')).filter((f) => f.data.status === 'published');
const featured = fawaid[0];

const topicCount = (slug: TopicSlug) =>
  lessons.filter((l) => l.data.topics.includes(slug)).length + fawaid.filter((f) => f.data.topics.includes(slug)).length;

const sections = [
  { href: '/lessons/', icon: 'headphones', title: 'تسجيلات المجالس' },
  { href: '/books/', icon: 'book', title: 'الكتب والرسائل' },
  { href: '/fawaid/', icon: 'quote', title: 'فوائد مختارة' },
  { href: '/about/', icon: 'user', title: 'تعريف بالشيخ' },
  { href: '/fathallah/', icon: 'user', title: 'الشيخ فتح الله إمام حمودة' },
  { href: '/gallery/', icon: 'image', title: 'مكتبة الصور' },
] as const;
---
<Base>
  <section class="hero pattern">
    <div class="wrap hero-inner">
      <div class="hero-text">
        <p class="eyebrow">١٩٠٨ – ١٩٨٧ م · رحمه الله</p>
        <h1><span class="h1-pre">فضيلة الشيخ</span><span class="h1-name">ماهر إسماعيل جاهين</span></h1>
        <p class="lead">{SITE_TAGLINE}</p>
        <div class="actions">
          <a class="btn gold" href={u('/lessons/')}><Icon name="headphones" size={18} /> استمع إلى الدروس</a>
          <a class="btn on-deep" href={u('/books/')}><Icon name="book" size={18} /> تصفح الكتب</a>
          <a class="btn on-deep" href={u('/about/')}><Icon name="user" size={18} /> تعريف بالشيخ</a>
        </div>
        <form class="hero-search" action={u('/search/')} role="search">
          <Icon name="search" size={18} />
          <input type="search" name="q" placeholder="ابحث في المجالس والكتب والفوائد…" aria-label="بحث" />
        </form>
      </div>
      <figure class="hero-figure">
        <img src={u('/media/images/sheikh-cutout.webp')} alt="فضيلة الشيخ ماهر إسماعيل جاهين" width="834" height="762" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <div class="wrap">
    <section class="tiles" aria-label="أقسام الموقع">
      {sections.map((s) => (
        <a class="card link tile" href={u(s.href)}>
          <span class="tile-icon"><Icon name={s.icon} size={26} /></span>
          <strong>{s.title}</strong>
        </a>
      ))}
    </section>

    <section class="section home-poem" aria-label="أبيات في الشيخ">
      <Poem poem={HOME_POEM} showTitle={false} preview={4} />
    </section>

    {featured && (
      <section class="featured">
        <p class="eyebrow">فوائد مختارة</p>
        <span class="big-quote" aria-hidden="true">”</span>
        <h2>{featured.data.quote ?? featured.data.title}</h2>
        {featured.data.summary && <p class="lead">{featured.data.summary}</p>}
        <div class="actions">
          <a class="btn" href={u(`/fawaid/${featured.id}/`)}>
            {featured.data.media?.type === 'video' ? <><Icon name="play" size={16} /> شاهد الفائدة</> : 'اقرأ الفائدة'}
          </a>
          {fawaid.length > 1 && <a class="btn ghost" href={u('/fawaid/')}>كل الفوائد</a>}
        </div>
      </section>
    )}

    <Ornament />

    <section class="section">
      <div class="section-head">
        <div><p class="eyebrow">استمع</p><h2>تسجيلات المجالس</h2></div>
        <a href={u('/lessons/')}>كل المجالس <Icon name="arrow" size={16} /></a>
      </div>
      <div class="grid">{lessons.slice(0, 6).map((l) => <LessonCard lesson={l} />)}</div>
    </section>

    <Ornament />

    <section class="section fathallah pattern">
      <figure class="arch"><img src={u('/media/images/shaikh-fathalla.webp')} alt="الشيخ فتح الله إمام حمودة" loading="lazy" /></figure>
      <div>
        <h2>الشيخ فتح الله إمام حمودة</h2>
        <p class="lead">حارس الإرث وصديق الشيخ ماهر جاهين، رحمهما الله. فرّغ دروس الشيخ من أشرطة الكاسيت، فحفظ لنا «سلسلة الدروس الإيمانية».</p>
        <div class="actions">
          <a class="btn gold" href={u('/fathallah/')}>سيرته</a>
          <a class="btn on-deep" href={u('/books/dros/')}>سلسلة الدروس الإيمانية</a>
        </div>
      </div>
    </section>

    <Ornament />

    <section class="section">
      <div class="section-head">
        <div><p class="eyebrow">اقرأ</p><h2>الكتب والرسائل</h2></div>
        <a href={u('/books/')}>المكتبة <Icon name="arrow" size={16} /></a>
      </div>
      <div class="shelf">
        {books.map((b) => (
          <article class="card link book-card">
            <div class="cover">
              {b.data.cover ? <img src={u(b.data.cover)} alt="" loading="lazy" /> : null}
              <span class="cover-fallback" aria-hidden="true"><Icon name="book" size={34} /></span>
            </div>
            <div>
              <p class="kind">{b.data.kind === 'series' ? 'سلسلة' : 'كتاب'}</p>
              <h3><a href={u(`/books/${b.id}/`)}>{b.data.title}</a></h3>
              <p class="meta">{b.data.summary}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <Ornament />

    <section class="section">
      <div class="section-head">
        <div><p class="eyebrow">تصفح</p><h2>الموضوعات</h2></div>
      </div>
      <div class="topics">
        {(Object.keys(TOPICS) as TopicSlug[]).map((slug) => (
          <a class="topic" href={u(`/topics/${slug}/`)}>
            <span>{TOPICS[slug]}</span>
            <small>{ar(topicCount(slug))}</small>
          </a>
        ))}
      </div>
    </section>

  </div>
</Base>

<style>
  .hero { position: relative; overflow: hidden; padding-top: 48px; isolation: isolate; }
  /* الزخرفة تبقى خافتة على اليمين وتذوب ناحية الشمال في ظل هادئ تقف فيه صورة الشيخ */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 75% at 22% 45%, rgb(216 180 106 / 16%), transparent 70%),
      linear-gradient(to left, transparent 30%, var(--deep) 75%);
  }
  .hero-inner { display: grid; gap: 0; align-items: end; }
  .hero-inner > * { min-width: 0; }
  .hero-text { text-align: center; padding-bottom: 88px; position: relative; }
  .hero-figure {
    margin: 0 auto -8px;
    width: min(100%, 460px);
    order: -1;
  }
  /* حواف الصورة تذوب في الخلفية بدل القطع الحاد */
  .hero-figure img {
    display: block;
    width: 100%;
    height: auto;
    opacity: .92;
    -webkit-mask-image: radial-gradient(ellipse 62% 72% at 50% 42%, #000 58%, transparent 100%);
    mask-image: radial-gradient(ellipse 62% 72% at 50% 42%, #000 58%, transparent 100%);
  }
  @media (min-width: 880px) {
    .hero { padding-top: 32px; }
    .hero-inner { grid-template-columns: 1.2fr 1fr; gap: 0; }
    .hero-text { text-align: start; align-self: center; padding-bottom: 100px; }
    .hero-figure { order: 0; width: min(140%, 780px); margin: 0 0 0 -30%; justify-self: end; }
  }
  .hero h1 { display: grid; gap: .1em; color: var(--on-deep); }
  @media (max-width: 879px) { .hero h1 { justify-items: center; } }
  .h1-pre { font-size: clamp(1.5rem, 3.4vw, 2.1rem); color: var(--gold-on-deep); }
  .h1-name { font-size: clamp(2.3rem, 5.6vw, 4rem); line-height: 1.25; }
  .hero .eyebrow { color: var(--gold-on-deep); }
  .hero .lead { color: var(--on-deep); max-width: 560px; margin-bottom: 28px; }
  @media (max-width: 879px) { .hero .lead { margin-inline: auto; } .hero .actions { justify-content: center; } .hero-search { margin-inline: auto; } }
  .hero-search {
    margin-top: 26px;
    display: flex;
    align-items: center;
    gap: 10px;
    width: min(100%, 460px);
    padding: 4px 18px;
    border-radius: 999px;
    background: rgb(11 45 37 / 55%);
    backdrop-filter: blur(4px);
    border: 1px solid rgb(216 180 106 / 35%);
    color: var(--on-deep-muted);
  }
  .hero-search input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    outline: 0;
    color: var(--on-deep);
    font: inherit;
    padding-block: 10px;
  }
  .hero-search input::placeholder { color: var(--on-deep-muted); }

  .tiles {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    margin-top: -56px;
    position: relative;
  }
  .fathallah {
    display: grid;
    gap: 32px;
    align-items: center;
    padding: 36px;
    border-radius: 24px;
  }
  .fathallah > * { min-width: 0; }
  @media (min-width: 760px) { .fathallah { grid-template-columns: 240px 1fr; } }
  .fathallah .arch { margin: 0; width: min(100%, 240px); justify-self: center; border-color: var(--gold-on-deep); background: rgb(255 255 255 / 4%); }
  .fathallah h2 { color: var(--on-deep); }
  .fathallah .eyebrow { color: var(--gold-on-deep); }
  .fathallah .lead { color: var(--on-deep-muted); }
  .tile {
    display: grid;
    gap: 6px;
    text-decoration: none;
    color: inherit;
  }
  .tile strong { font-family: var(--font-display); font-size: 1.3rem; }
  .tile-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: var(--surface-2);
    color: var(--accent);
    margin-bottom: 6px;
  }


  .kind { margin: 0; font-size: .82rem; font-weight: 600; color: var(--gold); }
  .featured {
    margin-top: 64px;
    text-align: center;
    padding: 48px 24px;
    border-radius: 24px;
    background: var(--surface);
    border: 1px solid var(--gold-soft);
    position: relative;
    overflow: hidden;
  }
  .featured .lead { margin-inline: auto; }
  .big-quote {
    position: absolute;
    top: 4px;
    inset-inline-end: 28px;
    font-family: var(--font-display);
    font-size: 8rem;
    line-height: 1;
    color: var(--gold-soft);
    pointer-events: none;
  }
  .featured h2 { font-size: clamp(1.8rem, 4.5vw, 2.6rem); position: relative; }
  .featured .actions { justify-content: center; }
  .shelf {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
  }
  .book-card {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 20px;
    align-items: start;
  }
  .cover {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 6px 10px 10px 6px;
    overflow: hidden;
    background: var(--deep);
    box-shadow: -4px 0 0 var(--gold) inset, var(--shadow);
  }
  .cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }
  .cover-fallback { position: absolute; inset: 0; display: grid; place-items: center; color: var(--gold-on-deep); }

  .topics {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
  }
  .topic {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    transition: border-color 0.15s, color 0.15s;
  }
  .topic:hover { border-color: var(--gold); color: var(--accent); }
  .topic small {
    min-width: 28px;
    text-align: center;
    padding: 0 8px;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--gold);
    font-weight: 600;
  }
</style>
