---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LessonCard from '../components/LessonCard.astro';
import FaidaCard from '../components/FaidaCard.astro';
import { u, ar } from '../lib/site';
import { TOPICS } from '../lib/topics';

const lessons = (await getCollection('lessons')).sort((a, b) => a.data.number - b.data.number);
const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order);
const fawaid = (await getCollection('fawaid')).filter((f) => f.data.status === 'published');
---
<Base>
  <section class="hero">
    <div>
      <p class="eyebrow">١٩٠٨ – ١٩٨٧ م · رحمه الله</p>
      <h1>فضيلة الشيخ ماهر إسماعيل جاهين</h1>
      <p class="lead">عالم نوبي ربّى تلاميذه على التوحيد وتزكية النفس، وهذا الموقع يجمع تراثه من دروس صوتية ورسائل وكتب وفوائد، ليبقى نورًا لطلاب العلم.</p>
      <div class="actions">
        <a class="btn" href={u('/lessons/')}>استمع إلى الدروس</a>
        <a class="btn ghost" href={u('/books/')}>تصفح الكتب</a>
        <a class="btn ghost" href={u('/about/')}>عن الشيخ</a>
      </div>
    </div>
    <img class="hero-img" src="https://shaikhmaher.com/wp-content/uploads/2026/04/sheikh-photo-1024x576.jpg" alt="الشيخ ماهر إسماعيل جاهين" width="1024" height="576" />
  </section>

  <section class="stats" aria-label="محتوى الأرشيف">
    <div><strong>{ar(lessons.length)}</strong><span>درسًا صوتيًا</span></div>
    <div><strong>{ar(books.length)}</strong><span>كتب ورسائل</span></div>
    <div><strong>{ar(fawaid.length)}</strong><span>فائدة</span></div>
  </section>

  <section class="section">
    <div class="section-head"><h2>أحدث الدروس</h2><a href={u('/lessons/')}>كل الدروس</a></div>
    <div class="grid">{lessons.slice(0, 3).map((l) => <LessonCard lesson={l} />)}</div>
  </section>

  <section class="section">
    <div class="section-head"><h2>الكتب والرسائل</h2><a href={u('/books/')}>المكتبة</a></div>
    <div class="grid">
      {books.map((b) => (
        <a class="card book-card" href={u(`/books/${b.id}/`)}>
          {b.data.cover && <img src={b.data.cover} alt="" loading="lazy" />}
          <div><h3>{b.data.title}</h3><p class="meta">{b.data.summary}</p></div>
        </a>
      ))}
    </div>
  </section>

  {fawaid.length > 0 && (
    <section class="section">
      <div class="section-head"><h2>من الفوائد</h2><a href={u('/fawaid/')}>كل الفوائد</a></div>
      <div class="grid">{fawaid.slice(0, 3).map((f) => <FaidaCard faida={f} />)}</div>
    </section>
  )}

  <section class="section">
    <h2>تصفح بالموضوع</h2>
    <ul class="tags">
      {Object.entries(TOPICS).map(([slug, label]) => <li><a class="tag topic" href={u(`/topics/${slug}/`)}>{label}</a></li>)}
    </ul>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: 32px;
    align-items: center;
  }
  @media (min-width: 860px) {
    .hero { grid-template-columns: 1.1fr 1fr; }
  }
  .hero-img {
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    aspect-ratio: 16 / 9;
    object-fit: cover;
    width: 100%;
  }
  .stats {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .stats div {
    padding: 16px;
    text-align: center;
    display: grid;
  }
  .stats div + div { border-inline-start: 1px solid var(--line); }
  .stats strong {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--accent);
    line-height: 1.3;
  }
  .stats span { color: var(--muted); font-size: 0.9rem; }
  .book-card {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 16px;
    text-decoration: none;
    color: inherit;
  }
  .book-card img { border-radius: 8px; aspect-ratio: 3 / 4; object-fit: cover; }
  .tag.topic { font-size: 1rem; padding: 6px 16px; }
</style>
