---
import { getCollection } from '../lib/content';
import Base from '../layouts/Base.astro';
import LessonCard from '../components/LessonCard.astro';
import FaidaCard from '../components/FaidaCard.astro';
import Icon from '../components/Icon.astro';
import Ornament from '../components/Ornament.astro';
import Poem from '../components/Poem.astro';
import { HOME_POEM } from '../data/poems';
import { u, ar, SITE_TAGLINE } from '../lib/site';
import { TOPICS, type TopicSlug } from '../lib/topics';

const lessons = (await getCollection('lessons')).sort((a, b) => a.data.number - b.data.number);
const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order);
const fawaid = (await getCollection('fawaid')).filter((f) => f.data.status === 'published');

const topicCount = (slug: TopicSlug) =>
  lessons.filter((l) => l.data.topics.includes(slug)).length + fawaid.filter((f) => f.data.topics.includes(slug)).length;

const sections = [
  { href: '/lessons/', icon: 'headphones', title: 'تسجيلات المجالس' },
  { href: '/books/', icon: 'book', title: 'الكتب والرسائل' },
  { href: '/fawaid/', icon: 'quote', title: 'فوائد مختارة' },
  { href: '/about/', icon: 'user', title: 'تعريف بالشيخ' },
  { href: '/fathallah/', icon: 'user', title: 'الشيخ فتح الله إمام حمودة' },
  { href: '/gallery/', icon: 'image', title: 'مكتبة الصور' },
] as const;
---
<Base>
  <section class="hero" style={`--hero-photo: url(${u('/media/images/sheikh-hero.webp')})`}>
    <div class="wrap hero-inner">
      <p class="eyebrow">١٩٠٨ – ١٩٨٧ م · رحمه الله</p>
      <h1><span class="h1-pre">فضيلة الشيخ</span><span class="h1-name">ماهر إسماعيل جاهين</span></h1>
      <p class="lead">{SITE_TAGLINE}</p>
      <div class="actions">
        <a class="btn gold" href={u('/lessons/')}><Icon name="headphones" size={18} /> استمع إلى الدروس</a>
        <a class="btn on-deep" href={u('/books/')}><Icon name="book" size={18} /> تصفح الكتب</a>
      </div>
      <form class="hero-search" action={u('/search/')} role="search">
        <Icon name="search" size={18} />
        <input type="search" name="q" placeholder="ابحث في المجالس والكتب والفوائد…" aria-label="بحث" />
      </form>
    </div>
  </section>

  <div class="wrap">
    <section class="tiles" aria-label="أقسام الموقع">
      {sections.map((s) => (
        <a class="card link tile" href={u(s.href)}>
          <span class="tile-icon"><Icon name={s.icon} size={26} /></span>
          <strong>{s.title}</strong>
        </a>
      ))}
    </section>

    <section class="section home-poem" aria-label="أبيات في الشيخ">
      <Poem poem={HOME_POEM} showTitle={false} />
    </section>

    <section class="section fathallah pattern">
      <figure class="arch"><img src={u('/media/images/shaikh-fathalla.webp')} alt="الشيخ فتح الله إمام حمودة" loading="lazy" /></figure>
      <div>
        <h2>الشيخ فتح الله إمام حمودة</h2>
        <p class="lead">حارس الإرث وصديق الشيخ ماهر جاهين، رحمهما الله. فرّغ دروس الشيخ من أشرطة الكاسيت، فحفظ لنا «سلسلة الدروس الإيمانية».</p>
        <div class="actions">
          <a class="btn gold" href={u('/fathallah/')}>سيرته</a>
          <a class="btn on-deep" href={u('/books/dros/')}>سلسلة الدروس الإيمانية</a>
        </div>
      </div>
    </section>

    <Ornament />

    {fawaid.length > 0 && (
      <section class="section">
        <div class="section-head">
          <div><p class="eyebrow">تأمل</p><h2>فوائد مختارة</h2></div>
          <a href={u('/fawaid/')}>كل الفوائد <Icon name="arrow" size={16} /></a>
        </div>
        <div class="reels">{fawaid.slice(0, 4).map((f) => <FaidaCard faida={f} />)}</div>
      </section>
    )}

    <Ornament />

    <section class="section">
      <div class="section-head">
        <div><p class="eyebrow">استمع</p><h2>تسجيلات المجالس</h2></div>
        <a href={u('/lessons/')}>كل المجالس <Icon name="arrow" size={16} /></a>
      </div>
      <div class="grid">{lessons.slice(0, 6).map((l) => <LessonCard lesson={l} />)}</div>
    </section>

    <Ornament />

    <section class="section">
      <div class="section-head">
        <div><p class="eyebrow">اقرأ</p><h2>الكتب والرسائل</h2></div>
        <a href={u('/books/')}>المكتبة <Icon name="arrow" size={16} /></a>
      </div>
      <div class="shelf">
        {books.map((b) => (
          <article class="card link book-card">
            <div class="cover">
              {b.data.cover ? <img src={u(b.data.cover)} alt="" loading="lazy" /> : null}
              <span class="cover-fallback" aria-hidden="true"><Icon name="book" size={34} /></span>
            </div>
            <div>
              <p class="kind">{b.data.kind === 'series' ? 'سلسلة' : 'كتاب'}</p>
              <h3><a href={u(`/books/${b.id}/`)}>{b.data.title}</a></h3>
              <p class="meta">{b.data.summary}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <Ornament />

    <section class="section">
      <div class="section-head">
        <div><p class="eyebrow">تصفح</p><h2>الموضوعات</h2></div>
      </div>
      <div class="topics">
        {(Object.keys(TOPICS) as TopicSlug[]).map((slug) => (
          <a class="topic" href={u(`/topics/${slug}/`)}>
            <span>{TOPICS[slug]}</span>
            <small>{ar(topicCount(slug))}</small>
          </a>
        ))}
      </div>
    </section>

  </div>
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: 64vh;
    padding-block: 72px 112px;
    background: var(--deep-2) var(--hero-photo) center 22% / cover no-repeat;
    text-align: center;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(240deg, rgb(11 45 37 / 72%) 0%, rgb(10 97 4 / 55%) 87%), rgb(0 0 0 / 18%);
  }
  .hero-inner { display: grid; justify-items: center; }
  .hero-inner > * { min-width: 0; }
  .hero h1 { display: grid; justify-items: center; gap: .1em; color: var(--on-deep); text-shadow: 0 2px 18px rgb(0 0 0 / 45%); }
  .h1-pre { font-size: clamp(1.5rem, 3.6vw, 2.2rem); color: var(--gold-on-deep); }
  .h1-name { font-size: clamp(2.4rem, 7vw, 4.4rem); line-height: 1.25; }
  .hero .eyebrow { color: var(--gold-on-deep); }
  .hero .lead { color: var(--on-deep); max-width: 640px; margin-bottom: 28px; text-shadow: 0 1px 10px rgb(0 0 0 / 50%); }
  .hero .actions { justify-content: center; }
  .hero-search {
    margin-top: 26px;
    display: flex;
    align-items: center;
    gap: 10px;
    width: min(100%, 460px);
    padding: 4px 18px;
    border-radius: 999px;
    background: rgb(11 45 37 / 55%);
    backdrop-filter: blur(4px);
    border: 1px solid rgb(216 180 106 / 35%);
    color: var(--on-deep-muted);
  }
  .hero-search input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    outline: 0;
    color: var(--on-deep);
    font: inherit;
    padding-block: 10px;
  }
  .hero-search input::placeholder { color: var(--on-deep-muted); }

  .tiles {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    margin-top: -56px;
    position: relative;
  }
  .fathallah {
    display: grid;
    gap: 32px;
    align-items: center;
    padding: 36px;
    border-radius: 24px;
  }
  .fathallah > * { min-width: 0; }
  @media (min-width: 760px) { .fathallah { grid-template-columns: 240px 1fr; } }
  .fathallah .arch { margin: 0; width: min(100%, 240px); justify-self: center; border-color: var(--gold-on-deep); background: rgb(255 255 255 / 4%); }
  .fathallah h2 { color: var(--on-deep); }
  .fathallah .eyebrow { color: var(--gold-on-deep); }
  .fathallah .lead { color: var(--on-deep-muted); }
  .tile {
    display: grid;
    gap: 6px;
    text-decoration: none;
    color: inherit;
  }
  .tile strong { font-family: var(--font-display); font-size: 1.3rem; }
  .tile-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: var(--surface-2);
    color: var(--accent);
    margin-bottom: 6px;
  }


  .kind { margin: 0; font-size: .82rem; font-weight: 600; color: var(--gold); }
  .shelf {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
  }
  .book-card {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 20px;
    align-items: start;
  }
  .cover {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 6px 10px 10px 6px;
    overflow: hidden;
    background: var(--deep);
    box-shadow: -4px 0 0 var(--gold) inset, var(--shadow);
  }
  .cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }
  .cover-fallback { position: absolute; inset: 0; display: grid; place-items: center; color: var(--gold-on-deep); }

  .topics {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
  }
  .topic {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    transition: border-color 0.15s, color 0.15s;
  }
  .topic:hover { border-color: var(--gold); color: var(--accent); }
  .topic small {
    min-width: 28px;
    text-align: center;
    padding: 0 8px;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--gold);
    font-weight: 600;
  }
</style>
