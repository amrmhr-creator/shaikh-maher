---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { u } from '../lib/site';

// النصوص من صفحة السيرة في الموقع القديم shaikhmaher.com/about بعد مراجعة الأستاذ عمرو.

const fields = [
  { title: 'علوم العقيدة', text: 'رسخ في علوم العقيدة وأحكم أصولها، فجمع بين عمق التأصيل وقوة الاستدلال.' },
  { title: 'الفقه الإسلامي', text: 'تعمَّق في الأحكام بعقليةٍ مستنيرةٍ تُوازن بين النصِّ الشرعي ومقتضيات العصر.' },
  { title: 'علم التفسير', text: 'برع في استنطاق النص القرآني، فمنحه ذلك قدرةً هائلة على تبسيط المعاني المعقدة لجمهور العامة والنخبة على حدٍّ سواء.' },
  { title: 'تزكية النفس', text: 'عُني بتزكية النفوس وتصفية القلوب، ورَسَخ في معاني الإخلاص ومجاهدة النفس، فغدت مواعظه زادًا للروح ونورًا يلامس القلوب.' },
];

const formation = [
  { when: 'عطبرة', title: 'المدرسة الثانوية الصناعية', text: 'سافر إلى أخيه بالسودان، فالتحق بالمدرسة الثانوية الصناعية بمدينة عطبرة، مما أهَّله للعمل بورش السكك الحديدية.' },
  { when: 'عصامية الروح', title: 'ورش السكك الحديدية', text: 'لم يكن يرى في الهندسة ومنازلة الحديد إلا تسبيحًا لله في ملكوته؛ كان يطوّع الحديد بيديه ويصقل قلبه بذكره.' },
  { when: 'العطاء المستمر', title: 'الاستقرار في بلانة', text: 'عاد إلى وطنه، وبعد تهجير بلاد النوبة استقرَّ في «بلانة»، فأسَّس مطحنًا وعمل بيده في الأرض خادمًا لأهل بلدته.' },
];

const travels = [
  { where: 'السودان', title: 'إذاعة أم درمان', text: 'كانت له أحاديث خاصة في إذاعة أم درمان، فأصبح صوته جزءًا من وجدان الشعب السوداني، متميِّزًا ببلاغةٍ نوبيةٍ عربيةٍ فريدة.' },
  { where: 'السعودية', title: 'مجلس العلماء', text: 'أوفدته دولةُ السودان لتمثيلها في مجلس العلماء بالسعودية، فطلب من الملك دمجَ علماء العالم الإسلامي بعلماء السعودية. استجاب الملكُ لطلبه وعرض عليه العمل، فاعتذر وآثر العودةَ لمواصلة رسالته.' },
  { where: 'الحجاز', title: 'مواسم الحج في منى وعرفات', text: 'كانت له ندوات كثيرة في موسم الحج بمنى وعرفات، يلتقي فيها وفود الحجيج بالموعظة الحسنة والفائدة الجامعة.' },
  { where: 'مصر', title: 'التليفزيون المصري: «نور على نور»', text: 'أحدث ظهوره مع الأستاذ أحمد فراج في برنامجه الديني الشهير «نور على نور» ضجةً كبرى؛ إذ لمس المشاهدون سَعةَ علمه، وعذوبةَ بيانه، وبساطةَ وصوله إلى القلوب.' },
];

const scholars = [
  'الشيخ محمود شلتوت',
  'الشيخ محمد حسين مخلوف، مفتي الجمهورية الأسبق',
  'الشيخ أبو العيون',
  'الشيخ عبد الحليم محمود',
  'الشيخ الدكتور ابن فتح الله بدران',
  'الشيخ محمد الغزالي',
];
---
<Base title="تعريف بالشيخ" description="تعريف بفضيلة الشيخ ماهر إسماعيل جاهين رحمه الله (١٩٠٨ – ١٩٨٧ م): مسيرة إيمانية جمعت بين علم وعمل ودعوة إلى الله.">
  <section class="pattern about-hero">
    <div class="wrap about-inner">
      <figure class="about-figure">
        <div class="arch">
          <img src={u('/media/images/shaikh-maher-young.webp')} alt="الشيخ ماهر إسماعيل جاهين في شبابه" width="945" height="1024" />
        </div>
      </figure>
      <div>
        <p class="eyebrow">تعريف بالشيخ</p>
        <h1>الشيخ ماهر إسماعيل جاهين</h1>
        <p class="lead">رحلةُ العلم والعمل والدعوة. عالمٌ جمع بين عمق التراث وأصالة الهوية، واستطاع بعبقريّته الفطرية أن يُبسِّط المعاني لجمهور العامة والنخبة على حدٍّ سواء.</p>
        <div class="life">
          <strong>١٩٠٨م <span aria-hidden="true">–</span> ١٩٨٧م</strong>
          <span>مسيرة إيمانية جمعت بين علمٍ وعملٍ ودعوةٍ إلى الله على بصيرة</span>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="chapters">
      <section class="chapter">
        <span class="mark" aria-hidden="true"></span>
        <h2>الجذور والنشأة الإيمانية</h2>
        <p>يُعدُّ الشيخ ماهر إسماعيل جاهين أحدَ أبرز الشخصيات النوبية في القرن العشرين؛ فهو العالم العلامة والداعية الذي استطاع بعبقريّته الفطرية أن يجمع بين عمق التراث الديني وأصالة الهوية، مستعينًا بسهولة البيان وعذوبة اللسان.</p>
        <p>وُلِد رحمه الله في مصر بقرية «الدر» بقلب بلاد النوبة عام ١٩٠٨م، وحفظ القرآن الكريم كاملًا في كُتّاب القرية. لم تكن طفولتُه ممهَّدة؛ فقد غيَّبه اليُتم عن والده مبكرًا، لكنَّ الله استودعه في كنف والدةٍ صالحةٍ كانت مدرستَه الأولى في الزُّهد والورع.</p>
        <p>في هذا البيت الذي أُسِّس على التقوى، نَمَتْ روحُه قبل بدنه، ليكون قلبُه وعاءً طاهرًا يستقبل فيوضات العلم، مما صقَل نفسَه الأبيّة وهيَّأها لبدء رحلةٍ زاخرةٍ تعبر حدودَ الجغرافيا.</p>
        <blockquote><p>«نَمَتْ روحُه قبل بدنه، وأُسِّس بنيانُه على عين الله»</p></blockquote>
      </section>

      <section class="chapter">
        <span class="mark" aria-hidden="true"></span>
        <h2>التكوين العملي بين النوبة والسودان</h2>
        <ol class="timeline">
          {formation.map((s) => (
            <li>
              <span class="dot" aria-hidden="true"></span>
              <h3>{s.when}<small>{s.title}</small></h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="chapter">
        <span class="mark" aria-hidden="true"></span>
        <h2>المصادر الثقافية: شموخ العقيدة ونَهَم المعرفة</h2>
        <p>كان الشيخ شديدَ الوُلوع بحلقات العلم والذكر التي تقوم على الوعي والفهم لكتاب الله وسنة رسوله ﷺ. أقبل بنَهَمٍ لا ينطفئ على كتب التفسير والفقه، فبنى نفسَه علميًا بعيدًا عن أروقة الجامعات التقليدية، لدرجةٍ أذهلت كبارَ علماء عصره كالشيخ محمود شلتوت والشيخ محمد الغزالي، الذين رأوا فيه نِدًّا وعالِمًا لا يُشَقّ له غبار.</p>
        <div class="cards">
          {fields.map((f, i) => (
            <article class="card info">
              <span class="num-badge">{'١٢٣٤'[i]}</span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="chapter">
        <span class="mark" aria-hidden="true"></span>
        <h2>لقاءاتُه وجولاتُه في الدعوة</h2>
        <p>أصبح سفيرًا للعلم والوسطية، مدعوًّا إلى إذاعاتٍ ومجالسَ ومؤتمراتٍ في مواطن عدة.</p>
        <div class="cards">
          {travels.map((t) => (
            <article class="card info">
              <p class="where">{t.where}</p>
              <h3>{t.title}</h3>
              <p>{t.text}</p>
            </article>
          ))}
        </div>
        <div class="subcard">
          <h3 class="subhead">صحبتُه لعلماء مصر</h3>
          <p>في بلده الأم مصر، كانت للشيخ صَولاتٌ وجَولاتٌ ولقاءاتٌ ومؤتمراتٌ، وقد ربطته علاقاتٌ علميةٌ وأخويةٌ بكوكبةٍ من علماء مصر، منهم:</p>
          <ul class="scholars">{scholars.map((s) => <li>{s}</li>)}</ul>
        </div>
      </section>

      <section class="chapter">
        <span class="mark" aria-hidden="true"></span>
        <h2>الخدمة العامة: تكليفٌ لا تشريف</h2>
        <p>اُختير الشيخ ماهر ممثلًا للنوبة في مجلس الشعب، فرأى نفسَه خادمًا اقتضت الحاجةُ تواجدَه. مارس دورَه السياسي لا استشرافًا، بل كأمانةٍ ثقيلةٍ لتحقيق الخدمة لأهله ومجتمعه. كان حضورُه وقورًا، يتحدث بلسان الأمة ويحمل همومَ النوبة، مطوِّعًا لغتَه وحكمتَه لفضِّ النزاعات وحلِّ الأزمات بذكاءٍ فِطري. كما حظي بتقديرٍ كبير من القيادة السياسية في عصره، ممثَّلةً في الرئيسين الراحلين جمال عبد الناصر وأنور السادات، تقديرًا لجهوده الدعوية وإسهاماته الاجتماعية.</p>
      </section>

      <section class="chapter">
        <span class="mark" aria-hidden="true"></span>
        <h2>الرحيل والإرث (١٩٨٧م)</h2>
        <p>رحل الشيخ ماهر إسماعيل جاهين عام ١٩٨٧م، تاركًا وراءه مدرسةً فكريةً تُبرهن على أن العالِم الحقيقي هو من يصنع نفسَه بالصبر والعمل. كان موسوعيًا بليغًا، يتحدث العربية بفصاحة النحويين، والنوبية بلسان الانتماء والجذور.</p>
        <div class="subcard">
          <h3 class="subhead">حافظُ الأمانة: فضيلة الشيخ فتح الله إمام حمودة رحمه الله</h3>
          <p>إنَّ الإرث الذي تركه الشيخ ماهر لم يَنطوِ بوفاته؛ فقد حمل أمانةَ البلاغ من بعده رفيقُه الوفيُّ، المربِّي الفاضلُ <a href={u('/fathallah/')}>الشيخ فتح الله حمودة</a>، الذي عكف بجهدٍ دؤوبٍ على تفريغ خطب الشيخ ودروسه من أشرطة الكاسيت، ليُخرجها للنور في سلسلة «الدروس الإيمانية في تزكية النفس البشرية». وقد شرع في كتابة مقدمةٍ للتعريف بشخصية الشيخ ماهر، مجيبًا على تساؤلات المحبين، إلا أن المنية عاجلته قبل أن يتمّها:</p>
          <blockquote><p>«أخانا القارئ الحبيب: سؤالٌ ظلَّت الإجابةُ عنه حائرةً طيلةَ سنين عديدة، يسأل المحبون والصالحون: ماذا تعرفون عن هذا الرجل الملهَم المتواضع؟ فتكون الإجابةُ بالصمت، والرجوعِ إلى الله بالشكر أن هيّأنا لمعرفة رجلٍ مثله يُنير لنا طريقَ الإيمان ويأخذ بأيدينا إلى برِّ السلام.»</p></blockquote>
        </div>
        <p>وقد أفردنا في هذا الموقع صفحةً خاصةً لعرض سيرة هذه الشخصية الفريدة. رحمه الله رحمةً واسعة، وأسكنه الفردوس الأعلى من الجنة، وجزاه عنا وعن المسلمين خير الجزاء.</p>
      </section>
    </div>

    <section class="legacy" aria-label="من تراث الشيخ">
      <a class="card link cta" href={u('/lessons/')}><span class="cta-icon"><Icon name="headphones" size={26} /></span><strong>تسجيلات المجالس</strong><span class="meta">استمع إلى تسجيلات مجالسه</span></a>
      <a class="card link cta" href={u('/books/')}><span class="cta-icon"><Icon name="book" size={26} /></span><strong>الكتب والرسائل</strong><span class="meta">اقرأ رسائله الإيمانية</span></a>
      <a class="card link cta" href={u('/fathallah/')}><span class="cta-icon"><Icon name="user" size={26} /></span><strong>الشيخ فتح الله حمودة</strong><span class="meta">حارس الإرث وصديق الشيخ</span></a>
    </section>
  </div>
</Base>

<style>
  .about-hero { padding-block: 56px; margin-bottom: 56px; }
  .about-inner { display: grid; gap: 40px; align-items: center; max-width: 980px; }
  .about-inner > * { min-width: 0; }
  @media (min-width: 880px) {
    .about-inner { grid-template-columns: 280px 1fr; }
  }
  .about-figure { margin: 0; justify-self: center; width: min(100%, 280px); }
  .about-figure .arch { border-color: var(--gold-on-deep); background: rgb(255 255 255 / 4%); }
  .about-hero h1 { color: var(--on-deep); }
  .about-hero .eyebrow { color: var(--gold-on-deep); }
  .about-hero .lead { color: var(--on-deep); opacity: .9; }

  .life {
    display: grid;
    gap: 4px;
    margin-top: 24px;
    padding: 16px 22px;
    border-radius: 14px;
    background: var(--deep-2);
    border: 1px solid rgb(216 180 106 / 35%);
    width: fit-content;
    max-width: 100%;
  }
  .life strong { color: var(--gold-on-deep); font-family: var(--font-display); font-size: 1.5rem; line-height: 1.5; }
  .life span { color: var(--on-deep); }

  .timeline { list-style: none; margin: 0; padding: 0; position: relative; }
  .timeline::before {
    content: '';
    position: absolute;
    inset-block: 14px;
    inset-inline-start: 8px;
    width: 2px;
    background: var(--gold-soft);
  }
  .timeline li { position: relative; padding-inline-start: 40px; }
  .timeline li + li { margin-top: 26px; }
  .dot {
    position: absolute;
    inset-inline-start: 0;
    top: .5em;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 4px var(--bg), 0 0 0 5px var(--gold-soft);
  }
  .timeline h3 { margin: 0 0 6px; font-size: 1.25rem; line-height: 1.6; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
  .timeline h3 small { font-family: var(--font-body); font-size: .9rem; font-weight: 600; color: var(--gold); }
  .timeline p { margin: 0; color: var(--text); line-height: 1.95; }

  .cards { display: grid; gap: 16px; margin-top: 8px; }
  @media (min-width: 640px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  .info { display: grid; justify-items: center; align-content: start; text-align: center; gap: 6px; padding: 26px 22px; }
  .info h3 { margin: 0; line-height: 1.6; }
  .info p { margin: 0; color: var(--text); line-height: 1.9; }
  .info .where { color: var(--gold); font-weight: 600; font-size: .9rem; }
  .info .num-badge { margin-bottom: 6px; }

  .scholars {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
  }
  .scholars li {
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--bg);
    border: 1px solid var(--line);
    font-weight: 600;
    text-align: center;
    line-height: 1.7;
  }

  .legacy {
    display: grid;
    gap: 16px;
    max-width: 860px;
    margin: 64px auto 0;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
  }
  .cta { display: grid; justify-items: center; text-align: center; gap: 4px; text-decoration: none; color: inherit; }
  .cta strong { font-family: var(--font-display); font-size: 1.3rem; }
  .cta-icon {
    width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center;
    background: var(--surface-2); color: var(--accent); margin-bottom: 8px;
  }
</style>
