# قاعدة البيانات (من لوحة Hostinger: Databases ← MySQL). من داخل الاستضافة استخدم 127.0.0.1.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# نص عشوائي طويل لتوقيع جلسات الدخول (مثلًا ناتج: openssl rand -hex 32)
SESSION_SECRET=

# أول مستخدم للوحة التحكم؛ يُنشأ مرة واحدة عند أول تشغيل إذا لم يوجد مستخدمون.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# مكان حفظ الملفات المرفوعة ورابطها العام.
# الافتراضي: مجلد uploads داخل التطبيق ويخدمه الموقع على /uploads/
# الأفضل على Hostinger: مجلد نطاق الوسائط حتى لا تُمسح الملفات مع النشر، مثل:
# UPLOAD_DIR=/home/<user>/domains/media.shaikhmaher.com/public_html/uploads
# UPLOAD_URL=https://media.shaikhmaher.com/uploads/
UPLOAD_DIR=
UPLOAD_URL=

# مدة حفظ المحتوى في الذاكرة بالثواني (التعديل من اللوحة يظهر فورًا على أي حال)
CACHE_TTL_SECONDS=60
